@model IEnumerable<ZMAttendanceMonitoring.Models.Attendance>

@{
    ViewData["Title"] = "Admin";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        @* <h2>📊 Admin History Reports</h2> *@
        @* <a asp-action="Index" class="btn btn-outline-secondary btn-sm">⬅️ Back to Home</a> *@
    </div>

    <!-- Date Filter & Export Panel -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body bg-light">
            <div class="row g-3 align-items-end">
                <!-- Filter form wrapper -->
                <div class="col-md-8">
                    <form asp-action="History" method="get" class="row g-3 align-items-end">
                        <div class="col-md-6">
                            <label for="filterDate" class="form-label fw-bold">Select Report Date:</label>
                            <input type="date" id="filterDate" name="filterDate" value="@ViewData["SelectedDate"]" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <button type="submit" class="btn btn-primary w-100">🔍 Generate Report</button>
                        </div>
                    </form>
                </div>

                <!-- Direct download anchor link -->
                <div class="col-md-4 text-md-end">
                    <a asp-action="ExportToCsv"
                       asp-route-filterDate="@ViewData["SelectedDate"]"
                       class="btn btn-success w-100">
                        📥 Download report (.CSV)
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Historical Data Summary Table -->
    <div class="card shadow-sm">
        <div class="card-header bg-secondary text-white font-weight-bold">
            Attendance Summary Report for: @ViewData["SelectedDate"]
        </div>
        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Employee Id</th>
                        <th>Employee Name</th>
                        <th>Check-In Time</th>
                        <th>Check-Out Time</th>
                        <th>Status</th>
                        <th class="text-end">Hours Worked</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">No records found for this date.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@(item.Employee != null ? item.Employee.Id : "Unknown Employee")</strong>
                                </td>
                                <td>
                                    <strong>@(item.Employee != null ? item.Employee.FullName : "Unknown Employee")</strong>
                                </td>
                                <td>@item.CheckInTime?.ToString("hh:mm tt")</td>
                                <td>@(item.CheckOutTime?.ToString("hh:mm tt") ?? "—")</td>
                                <td>
                                    @if (item.CheckOutTime != null)
                                    {
                                        <span class="badge bg-success">Shift Completed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Still On Clock</span>
                                    }
                                </td>
                                <td class="text-end fw-bold text-primary">
                                    @item.TotalHoursWorked
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <br />
    <!-- Links in header profile -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        @* <h2>📊 Admin History Reports</h2> *@
        <br />
        <div>
            <a asp-action="AddEmployee" class="btn btn-sm btn-primary me-2">Add Employee</a>
            <a asp-action="ChangePassword" class="btn btn-sm btn-outline-dark me-2">Change Password</a>
            <a asp-action="Logout" class="btn btn-sm btn-danger me-2">Log Out from Admin Page</a>
        </div>
    </div>

    <!-- Pagination Controls (Maintains Filter Date Parameter) -->
    @if ((int)ViewData["TotalPages"] > 1)
    {
        <nav aria-label="Admin log navigation" class="mt-3">
            <ul class="pagination justify-content-center">

                <!-- Previous Button -->
                <li class="page-item @((int)ViewData["CurrentPage"] == 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="History"
                       asp-route-filterDate="@ViewData["SelectedDate"]"
                       asp-route-page="@((int)ViewData["CurrentPage"] - 1)">
                        Previous
                    </a>
                </li>

                <!-- Page Number Links -->
                @for (int i = 1; i <= (int)ViewData["TotalPages"]; i++)
                {
                    <li class="page-item @(i == (int)ViewData["CurrentPage"] ? "active" : "")">
                        <a class="page-link"
                           asp-action="History"
                           asp-route-filterDate="@ViewData["SelectedDate"]"
                           asp-route-page="@i">
                            @i
                        </a>
                    </li>
                }

                <!-- Next Button -->
                <li class="page-item @((int)ViewData["CurrentPage"] == (int)ViewData["TotalPages"] ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="History"
                       asp-route-filterDate="@ViewData["SelectedDate"]"
                       asp-route-page="@((int)ViewData["CurrentPage"] + 1)">
                        Next
                    </a>
                </li>

            </ul>
        </nav>
    }

    @if (TempData["AdminMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm mb-3">@TempData["AdminMessage"]</div>
    }
</div>
